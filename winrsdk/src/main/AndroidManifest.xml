<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Streak push reminders (Android 13+). Gated at runtime on
         WINROptions.enablePushReminders; no-op when the host disables it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- adjustResize: keyboard must never block text fields (2.9) — the
             Compose screens pair this with imePadding() + scroll. -->
        <activity
            android:name=".ui.WINRExperienceActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>

</manifest>
